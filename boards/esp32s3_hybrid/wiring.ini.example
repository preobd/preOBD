[esp32s3_hybrid]
wiring =
;    -D RGB_PIN_R=11
;    -D RGB_PIN_G=12
;    -D RGB_PIN_B=13
;    -D BUZZER_PIN=3
;    -D MODE_BUTTON_PIN=5
;    -D TEST_MODE_PIN=8
;    -D SD_PIN=4           ; external SD card CS pin (enables SD logging)
;    -D I2C_WIRED_BUS=0    ; this I2C instance is physically wired
;    -D SPI_WIRED_BUS=0    ; this SPI instance is physically wired
;    -D CAN_WIRED_BUS=0    ; a transceiver is wired to this CAN instance (0=TWAI, 1=MCP2515)
