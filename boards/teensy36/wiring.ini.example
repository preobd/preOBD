; boards/teensy36/wiring.ini — YOUR Teensy 3.6 wiring (gitignored).
; Copy to `wiring.ini` (drop `.example`) and uncomment the pins you wired.
; These -D flags feed boards/resolve.h. Omit a pin → that peripheral is off.

[teensy36]
wiring =
;    -D RGB_PIN_R=11       ; RGB status LED (PWM-capable pins)
;    -D RGB_PIN_G=12
;    -D RGB_PIN_B=13
;    -D BUZZER_PIN=3       ; alarm buzzer (tone output)
;    -D MODE_BUTTON_PIN=5  ; CONFIG-on-boot / silence button
;    -D TEST_MODE_PIN=8    ; hold LOW at boot to enter test mode (optional)
