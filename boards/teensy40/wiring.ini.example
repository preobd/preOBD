; boards/teensy40/wiring.ini — YOUR Teensy 4.0 wiring (gitignored).
;
; Copy to `wiring.ini` (drop `.example`) and uncomment the pins you wired.
; These -D flags feed boards/resolve.h. Omit a pin → that peripheral is off.
; The 4.0 has no built-in SD; wire an external card + set SD_PIN to enable logging.

[teensy40]
wiring =
;    -D RGB_PIN_R=6        ; RGB status LED (PWM-capable pins)
;    -D RGB_PIN_G=5
;    -D RGB_PIN_B=4
;    -D BUZZER_PIN=3       ; alarm buzzer (tone output)
;    -D MODE_BUTTON_PIN=2  ; CONFIG-on-boot / silence button
;    -D TEST_MODE_PIN=8    ; hold LOW at boot to enter test mode (optional)
;    -D SD_PIN=10          ; external SD card CS pin (enables SD logging)
;    -D HOST_NRF_CTS_PIN=3 ; nRF52840 software flow control — define BOTH or neither
;    -D HOST_NRF_RTS_PIN=2 ;   (Teensy reads CTS, drives RTS; no-op if either omitted)
