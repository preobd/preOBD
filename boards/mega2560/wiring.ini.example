; boards/mega2560/wiring.ini — YOUR Mega 2560 wiring (gitignored).
;
; Copy to `wiring.ini` (drop `.example`) and uncomment the pins you wired.
; These -D flags feed boards/resolve.h. Omit a pin → that peripheral is off.
; (SD logging is vetoed on this board by board.h — the 8 KB RAM budget — so
; SD_PIN has no effect here.)

[mega2560]
wiring =
;    -D RGB_PIN_R=11       ; RGB status LED (PWM-capable pins)
;    -D RGB_PIN_G=12
;    -D RGB_PIN_B=13
;    -D BUZZER_PIN=3       ; alarm buzzer (tone output)
;    -D USER_BUTTON_PIN=5  ; CONFIG-on-boot / silence button
;    -D I2C_WIRED_BUS=0    ; this I2C instance is physically wired (only Wire exists)
;    -D SPI_WIRED_BUS=0    ; this SPI instance is physically wired (only SPI exists)
;    -D CAN_CS_0=9         ; MCP2515 CAN shield/module chip-select (Seeed shield: 9).
;                          ; No CAN_CS_0, no CAN in the image. It sits on SPI, so
;                          ; SPI_WIRED_BUS=0 above is needed too, or CAN stays down.
;    -D CAN_INT_0=2        ; MCP2515 interrupt pin (reserved; Seeed shield: 2)
;    -D CAN_WIRED_BUS=0    ; CAN1 on by default, OBD on it, until you configure it
;    -D MCP2515_CLOCK_16MHZ ; the MCP2515's crystal is 16 MHz (Seeed and most shields);
;                          ; omit for an 8 MHz module. A wrong crystal runs the bus at the
;                          ; wrong bit rate with no error: CAN1 comes up, nothing is heard
