#!/bin/bash
# preOBD pre-commit hook -- registry regeneration + src/ layering guard
#
# Tracked at .githooks/pre-commit (see #401 slice 5). A fresh clone or
# worktree needs `git config core.hooksPath .githooks` -- git does not set
# this automatically; see CLAUDE.md.

# Definitions moved from the headers into these .cpp files in #400 (one copy
# instead of one per translation unit). Both spellings are watched: the .cpp
# files now carry the DATA, the headers still carry the extern declarations.
REGISTRY_FILES="src/sensors/(sensor_library|application_presets|units_registry)\.(h|cpp)"
GENERATED_ENUM="src/sensors/generated/registry_enums.h"

# Check if registry files changed
if git diff --cached --name-only | grep -qE "$REGISTRY_FILES"; then
    echo "📝 Registry files changed, regenerating enums..."

    # Regenerate enum header
    python3 tools/generate_registry_enums.py

    if [ $? -ne 0 ]; then
        echo "❌ Enum generation failed!"
        exit 1
    fi

    # Add generated file to commit
    git add "$GENERATED_ENUM"
    echo "✓ Enums regenerated and staged"

    # Validate registries
    echo "🔍 Validating registries..."
    python3 tools/validate_registries.py --project-dir . --ci

    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Registry validation failed!"
        echo "Please fix the errors above before committing."
        exit 1
    fi

    echo "✓ Registry validation passed"
fi

# Layering guard (#401 slice 5): reports on the src/ dependency structure
# and fails only on an edge not already recorded in
# tools/layering_exceptions.txt (a ratchet, not a wall).
echo "🔍 Checking src/ layering..."
python3 tools/check_layering.py --quiet

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Layering check failed!"
    echo "Either a new cross-directory dependency isn't listed in"
    echo "tools/layering_exceptions.txt, or a file in outputs/formats/ includes"
    echo "hal/ or transports/ without a FORMATS line there (ARCHITECTURE.md 14.10)."
    echo "Fix the dependency, or if it's a deliberate, reviewed addition, add a"
    echo "cited line to that file."
    exit 1
fi

echo "✓ Layering check passed"

# Pin-ownership guard (ARCHITECTURE.md §12.5): every direct pin drive is
# listed in tools/pin_drive_sites.txt, and only pin_owner.cpp writes the
# registry unchecked. A ratchet: a new drive site fails the commit.
echo "🔍 Checking pin drives..."
python3 tools/test_check_pins.py >/dev/null && python3 tools/test_check_maps.py >/dev/null && python3 tools/test_check_layering.py >/dev/null
if [ $? -ne 0 ]; then
    echo "❌ The pin/map/layering checkers' self-tests failed (run tools/test_check_pins.py, tools/test_check_maps.py, tools/test_check_layering.py)"
    exit 1
fi
python3 tools/check_pins.py --quiet

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Pin check failed!"
    echo "A pin is driven directly without being listed, or the registry is"
    echo "written outside pin_owner.cpp. A claimant may drive only a pin it"
    echo "claimed first and still holds (§12.5); check that, then list the site."
    exit 1
fi

echo "✓ Pin check passed"

# Maps of record (architecture/maps/, private repo): warn here when a map's
# described files changed without a re-trace; CI fails on it (--strict).
python3 tools/check_maps.py

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Map check failed! (a malformed map, or src/README.md misses a src/ folder)"
    exit 1
fi

# Docs drift guard: every command, sensor and application name in README.md
# and docs/ must exist in the firmware. Runs on every commit because a CLI or
# registry change can break the docs without touching them.
echo "🔍 Checking docs against the firmware..."
python3 tools/check_docs.py

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Docs check failed!"
    echo "A doc names a command, sensor or application the firmware doesn't have"
    echo "(or the firmware changed under the doc). Fix the doc, or mark an"
    echo "intentional example with <!-- docs-check: ignore -->."
    exit 1
fi

echo "✓ Docs check passed"

exit 0
